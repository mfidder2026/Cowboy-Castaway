
d:\dev\cc65>REM @echo off 

d:\dev\cc65>rem ============================================================ 

d:\dev\cc65>rem  build.bat - Cowboy op het eiland: compileren en starten 

d:\dev\cc65>rem  Zet dit bestand in dezelfde map als main.c 

d:\dev\cc65>rem ============================================================ 

d:\dev\cc65>rem --- Paden naar jouw installatie ----------------------------- 

d:\dev\cc65>set CC65_HOME=D:\dev\cc65 

d:\dev\cc65>set CL65="D:\dev\cc65\cc65\bin\cl65.exe" 

d:\dev\cc65>set VICE="D:\dev\cc65\vice\bin\x64sc.exe" 

d:\dev\cc65>rem ------------------------------------------------------------- 

d:\dev\cc65>echo [1/2] Compileren... 
[1/2] Compileren...

d:\dev\cc65>"D:\dev\cc65\cc65\bin\cl65.exe" -O -t c64 main.c cowboy_frames.c island_gfx.c intro_gfx.c anims.c -o cowboy.prg 
