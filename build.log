main.c:1169: Warning: Variable 'jump_arc_y' is defined but never used

d:\dev\cc65>if errorlevel 1 (
echo. 
 echo *** Compileren MISLUKT - emulator wordt niet gestart. ***  
 pause 
 exit /b 1 
) 

d:\dev\cc65>echo [2/2] Starten in VICE... 
[2/2] Starten in VICE...

